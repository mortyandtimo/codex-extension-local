# 默认自动检测文本与二进制
* text=auto

# 脚本按各自的平台约定
*.cmd text eol=crlf
*.bat text eol=crlf
*.vbs text eol=crlf
*.ps1 text eol=crlf
*.sh  text eol=lf

# 文档与源码统一 LF
*.md   text eol=lf
*.mjs  text eol=lf
*.js   text eol=lf
*.json text eol=lf

# 明确标记二进制，避免任何行尾转换
*.png    binary
*.jpg    binary
*.webp   binary
*.gif    binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.wav    binary
*.mp3    binary
*.wasm   binary
*.br     binary
*.zip    binary
*.pptx   binary
*.docx   binary
*.xlsx   binary
*.pdf    binary

# 语言统计时排除打包产物
extension/assets/** linguist-vendored
extension/codex-sidepanel/assets/** linguist-vendored
extension/chunks/** linguist-vendored
